{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "obsidian-crm-voice-edge",
  "main": "src/index.ts",
  "compatibility_date": "2024-05-02",
  "compatibility_flags": [
    "durable_object_sqlite"
  ],
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CRM_VOICE_ASSISTANT",
        "class_name": "CRMVoiceAssistant"
      }
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "obsidiandashoarddb",
      "database_id": "adc1da90-6d37-45e1-88ce-9522ea7bf3ee"
    }
  ],
  "vars": {
    "VOICE_STT_MODEL": "@cf/openai/whisper-large-v3",
    "VOICE_TTS_VOICE": "en-US-neural-male",
    "INTERNAL_API_SECRET": "enterprise_sandbox_token_default_sha512",
    "SECURE_EGRESS_WHITELIST": "api.internal.enterprise,crm.corporate.local,secure.erp.cloud"
  },
  "migrations": [
    {
      "tag": "v1-bootstrap-durable-object-sqlite",
      "new_sqlite_classes": [
        "CRMVoiceAssistant"
      ]
    }
  ]
}
