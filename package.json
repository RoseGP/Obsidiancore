{
  "name": "omnichannel-crm-chatbot",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "NODE_ENV=production node dist/server.cjs",
    "lint": "tsc --noEmit && node scripts/lint-guards.mjs",
    "test": "npx tsx src/tests/messagingIntegration.test.ts",
    "test:payments": "npx tsx src/tests/paymentIntegration.test.ts",
    "test:stripe": "npx tsx src/tests/stripePaymentIntegration.test.ts",
    "test:video": "npx tsx src/tests/videoMeetingIntegration.test.ts",
    "test:invoicing": "npx tsx src/features/invoicing/__tests__/calc.test.ts && npx tsx src/features/invoicing/__tests__/api.test.ts && npx tsx src/features/invoicing/__tests__/store.test.ts",
    "test:social-accounts": "npx tsx src/features/social-accounts/__tests__/api.test.ts oauth && npx tsx src/features/social-accounts/__tests__/api.test.ts shared && npx tsx src/features/social-accounts/__tests__/firestoreStore.test.ts",
    "test:local-seo": "npx tsx src/features/gbp/__tests__/localSeo.test.ts",
    "test:voice-ivr": "npx tsx src/features/voice/__tests__/ivr.test.ts",
    "test:security": "npx tsx src/server/__tests__/security.test.ts && npx tsx src/server/__tests__/phase0.test.ts && npx tsx src/server/__tests__/tenancy.test.ts",
    "test:meeting-controls": "npx tsx src/components/greet/__tests__/meetingControls.test.tsx",
    "test:assistant": "npx tsx src/services/__tests__/assistant.test.ts",
    "test:ai": "npx tsx src/services/ai/__tests__/aiService.test.ts",
    "test:embed": "npx tsx src/routes/__tests__/embedEvents.test.ts",
    "key:generate": "node scripts/generate-api-key.mjs",
    "test:api-key": "npx tsx src/server/__tests__/apiKeyAuth.test.ts",
    "typecheck": "tsc --noEmit",
    "test:communication": "npx tsx src/routes/__tests__/communication.test.ts",
    "test:ci": "npm run -s test && npm run -s test:lead-intelligence && npm run -s test:command-center && npm run -s test:meeting-notes && npm run -s test:account && npm run -s test:dashboard && npm run -s test:communication && npm run -s test:messaging && npm run -s test:stripe && npm run -s test:video && npm run -s test:invoicing && npm run -s test:proposals && npm run -s test:social-accounts && npm run -s test:local-seo && npm run -s test:voice-ivr && npm run -s test:security && npm run -s test:meeting-controls && npm run -s test:meeting-session && npm run -s test:meeting-plans && npm run -s test:meeting-summary && npm run -s test:assistant && npm run -s test:ai && npm run -s test:embed && npm run -s test:api-key && npm run -s test:google && npm run -s test:greet",
    "test:google": "npx tsx src/server/__tests__/googleTokens.test.ts",
    "test:meeting-session": "npx tsx src/context/__tests__/meetingSession.test.tsx",
    "test:meeting-summary": "npx tsx src/services/__tests__/meetingSummary.test.ts",
    "test:meeting-plans": "npx tsx src/lib/__tests__/meetingPlans.test.ts && npx tsx src/server/meetings/__tests__/subscriptions.test.ts && npx tsx src/server/meetings/__tests__/media.test.ts",
    "test:greet": "npx tsx src/server/greet/__tests__/greet.test.ts",
    "test:meeting-notes": "npx tsx src/server/meetings/__tests__/notes.test.ts",
    "test:proposals": "npx tsx src/features/proposals/__tests__/proposals.test.ts",
    "test:messaging": "npx tsx src/routes/__tests__/messaging.test.ts",
    "test:dashboard": "npx tsx src/lib/__tests__/dashboardMetrics.test.ts && npx tsx src/lib/__tests__/commandCenter.test.ts && npx tsx src/components/dashboard/__tests__/widgets.test.tsx",
    "test:account": "npx tsx src/routes/__tests__/account.test.ts",
    "test:lead-intelligence": "npx tsx src/server/crm/__tests__/leadIntelligence.test.ts",
    "test:command-center": "npx tsx src/routes/__tests__/commandCenter.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.132.1",
    "@google/genai": "^2.4.0",
    "@hookform/resolvers": "^5.9.1",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "^9.2.4",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@types/dompurify": "^3.2.0",
    "@types/luxon": "^3.7.5",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.18.0",
    "bullmq": "^6.3.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.15",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.1.0",
    "googleapis": "^178.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "livekit-client": "2.22.4",
    "livekit-server-sdk": "2.19.1",
    "lucide-react": "^0.546.0",
    "luxon": "^3.7.2",
    "mailparser": "^3.9.22",
    "motion": "^12.23.24",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.0",
    "openai": "^7.8.0",
    "pg": "^8.23.0",
    "postal-mime": "^3.0.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hook-form": "^7.87.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "4.0.1",
    "smtp-server": "^3.19.8",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.8",
    "stripe": "^22.6.2",
    "tailwind-merge": "^3.0.2",
    "twilio": "^6.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@types/supertest": "^6.0.3",
    "esbuild": "^0.25.0",
    "happy-dom": "15.11.7",
    "supertest": "^7.1.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
