{
  "name": "omnichannel-crm-chatbot",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "test": "npx tsx src/tests/messagingIntegration.test.ts",
    "test:payments": "npx tsx src/tests/paymentIntegration.test.ts",
    "test:stripe": "npx tsx src/tests/stripePaymentIntegration.test.ts",
    "test:postiz": "npx tsx src/tests/postizIntegration.test.ts",
    "test:video": "npx tsx src/tests/videoMeetingIntegration.test.ts",
    "test:invoicing": "npx tsx src/features/invoicing/__tests__/calc.test.ts && npx tsx src/features/invoicing/__tests__/api.test.ts",
    "test:social-accounts": "npx tsx src/features/social-accounts/__tests__/api.test.ts oauth && npx tsx src/features/social-accounts/__tests__/api.test.ts shared && npx tsx src/features/social-accounts/__tests__/firestoreStore.test.ts",
    "test:local-seo": "npx tsx src/features/gbp/__tests__/localSeo.test.ts",
    "test:voice-ivr": "npx tsx src/features/voice/__tests__/ivr.test.ts",
    "test:security": "npx tsx src/server/__tests__/security.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@hookform/resolvers": "^5.9.1",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "^9.2.4",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@types/dompurify": "^3.2.0",
    "@types/luxon": "^3.7.5",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.18.0",
    "bullmq": "^6.3.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.15",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.1.0",
    "googleapis": "^178.0.0",
    "ioredis": "^6.0.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "luxon": "^3.7.2",
    "mailparser": "^3.9.22",
    "motion": "^12.23.24",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.0",
    "openai": "^7.8.0",
    "pg": "^8.23.0",
    "postal-mime": "^3.0.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hook-form": "^7.87.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "smtp-server": "^3.19.8",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.8",
    "stripe": "^22.6.2",
    "tailwind-merge": "^3.0.2",
    "twilio": "^6.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@types/supertest": "^6.0.3",
    "esbuild": "^0.25.0",
    "supertest": "^7.1.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
