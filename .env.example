# OmniRoute Gateway Configuration
OMNIROUTE_GATEWAY_URL=http://localhost:20128
OMNIROUTE_API_KEY=sk-omniroute-default-key

# Fallback AI Model Provider (Gemini API)
GEMINI_API_KEY=

# Firebase Configuration
VITE_FIREBASE_PROJECT_ID=myformspree
VITE_FIREBASE_FIRESTORE_DATABASE_ID=ai-studio-omnichannelcrm-db8d10f6-218d-4bf0-9c46-21c81254257b

# Postiz Integration Configuration (Official Public API v1)
# Base API: https://api.postiz.com/public/v1
# Documentation: https://docs.postiz.com/public-api
POSTIZ_CLIENT_ID=pca_omnichannel_crm_standard
POSTIZ_CLIENT_SECRET=pcs_omnichannel_secret_live
POSTIZ_BASE_URL=https://api.postiz.com
POSTIZ_API_URL=https://api.postiz.com/public/v1
POSTIZ_AUTH_URL=https://platform.postiz.com/oauth/authorize
POSTIZ_TOKEN_URL=https://api.postiz.com/oauth/token
POSTIZ_REDIRECT_URI=http://localhost:3000/api/postiz/callback
POSTIZ_WEBHOOK_SECRET=postiz_webhook_secret_standard
# Optional fallback direct API key (pos_...) or workspace key
POSTIZ_API_KEY=


# ---------------------------------------------------------------------------
# Security hardening (required in production — the server refuses to start without these)
# Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_SECRET=
ENCRYPTION_KEY=                     # exactly 32 characters (AES-256 key)
PAYMENT_ENCRYPTION_SECRET=
OAUTH_STATE_SECRET=
CRM_WEBHOOK_SECRET=
WHATSAPP_VERIFY_TOKEN=
SOCIAL_ACCOUNTS_ENCRYPTION_KEY=
STRIPE_WEBHOOK_SECRET=              # unsigned Stripe webhooks are rejected in production

# Inbound SMTP TLS (without these, STARTTLS is disabled instead of using a public default key)
SMTP_TLS_KEY_PATH=
SMTP_TLS_CERT_PATH=

# Local development only (both ignored when NODE_ENV=production)
SOCIAL_ACCOUNTS_DEV_AUTH=true       # accept the sandbox identity header on the API
VITE_ENABLE_SANDBOX_LOGIN=          # "true" shows sandbox personas in a non-dev build (staging previews)

# AI assistant: Gemini, optionally routed through an OmniRoute gateway
GEMINI_API_KEY=
OMNIROUTE_GATEWAY_URL=
OMNIROUTE_API_KEY=
