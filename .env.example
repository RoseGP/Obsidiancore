# Firebase Configuration
VITE_FIREBASE_PROJECT_ID=myformspree
VITE_FIREBASE_FIRESTORE_DATABASE_ID=ai-studio-omnichannelcrm-db8d10f6-218d-4bf0-9c46-21c81254257b

# Public address of this CRM (OAuth redirects, webhooks, invite links), no trailing slash
APP_URL=                            # e.g. https://crm.yourdomain.com  (local: http://localhost:3000)

# ---------------------------------------------------------------------------
# Postiz (Social Planner). See docs/social-accounts/POSTIZ_CAPABILITIES.md
# ---------------------------------------------------------------------------
# Self-hosted Postiz: just its address. The app then uses <url>/api for the backend
# (OAuth token + public API) and <url> for the consent page, Postiz's docker-compose layout.
POSTIZ_URL=                         # e.g. https://postiz.yourdomain.com
# Postiz Cloud instead: leave POSTIZ_URL empty (defaults: api.postiz.com / platform.postiz.com).
# Overrides, only if your layout differs (a trailing /public/v1 is removed automatically):
POSTIZ_API_URL=
POSTIZ_FRONTEND_URL=

# Mode 1 (each user authorizes their own Postiz workspace): Postiz → Settings → OAuth apps.
# Set the OAuth app's redirect URL in Postiz to  <APP_URL>/api/accounts/callback
POSTIZ_CLIENT_ID=                   # pca_…
POSTIZ_CLIENT_SECRET=               # pcs_…
POSTIZ_REDIRECT_URI=                # optional; defaults to <APP_URL>/api/accounts/callback

# Mode 2 (one shared workspace for the whole team), used when POSTIZ_CLIENT_ID is empty:
POSTIZ_API_KEY=                     # Postiz → Settings → Public API
# Self-hosted only: your Postiz JWT_SECRET. Sends users back to the CRM after they connect
# a channel (full redirect instead of a pop-up).
POSTIZ_ENTERPRISE_JWT_SECRET=

# Legacy /api/postiz routes only (the Social Planner doesn't use these):
POSTIZ_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Security hardening (required in production — the server refuses to start without these)
# Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_SECRET=
ENCRYPTION_KEY=                     # exactly 32 characters (AES-256 key)
GOOGLE_TOKEN_ENCRYPTION_KEY=        # optional: encrypts per-user Google tokens (falls back to ENCRYPTION_KEY)
PAYMENT_ENCRYPTION_SECRET=
OAUTH_STATE_SECRET=
CRM_WEBHOOK_SECRET=
WHATSAPP_VERIFY_TOKEN=
SOCIAL_ACCOUNTS_ENCRYPTION_KEY=
STRIPE_WEBHOOK_SECRET=              # unsigned Stripe webhooks are rejected in production

# Inbound SMTP TLS (without these, STARTTLS is disabled instead of using a public default key)
SMTP_TLS_KEY_PATH=
SMTP_TLS_CERT_PATH=

# Webhook signature keys. Without them the webhook is REJECTED (no unsigned fallback).
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=    # optional; defaults to $APP_URL/api/webhooks/square (must match Square exactly)
META_APP_SECRET=                    # WhatsApp / Meta webhooks (X-Hub-Signature-256)
TWILIO_AUTH_TOKEN=                  # Twilio SMS / voice webhooks (X-Twilio-Signature)
IVR_ALLOWED_HOSTS=                  # host name(s) Twilio calls, e.g. crm.example.com

# NODE_ENV: `npm run dev` sets development, `npm start` sets production. If it's unset, the server
# assumes production. The two flags below work ONLY when NODE_ENV is exactly development or test.
SOCIAL_ACCOUNTS_DEV_AUTH=true       # accept the sandbox X-Dev-User-Id header (opt-in)
ALLOW_UNSIGNED_WEBHOOKS=            # "true" accepts unsigned Stripe/Square/Meta webhooks for local testing
VITE_ENABLE_SANDBOX_LOGIN=          # "true" shows sandbox personas in a non-dev build (staging previews)


# ---------------------------------------------------------------------------
# CRM data & organizations (Phase 1)
# ---------------------------------------------------------------------------
CRM_STORE=                          # firestore | memory. Default: firestore in production, memory otherwise
CRM_AUTO_PROVISION_ORG=             # "false": users without an organization get 403 instead of a personal one
LEGACY_LEAD_CAPTURE_ORG_ID=         # temporary: route website-form leads that have no key to this organization

# ---------------------------------------------------------------------------
# AI assistant providers (dashboard assistant, POST /api/chat, /api/chat/completions)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=                       # default gemini-3.8-flash; falls back to gemini-2.5-flash if unavailable
GEMINI_MAX_OUTPUT_TOKENS=           # cap on the model's own output limit (default 32768)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=                    # default claude-sonnet-5-5
ANTHROPIC_MAX_OUTPUT_TOKENS=        # default 32000
# With both keys set, each provider backs up the other when one is rate-limited or down.
# Optional OpenAI-compatible gateway, used only for non-Gemini/Claude model ids:
OMNIROUTE_GATEWAY_URL=
OMNIROUTE_API_KEY=

# Embeddable calendar (public/widget.js, /api/v1/events). See docs/embed-calendar/README.md
EMBED_TOKEN_SECRET=                 # 32+ random chars; signs staff embed tokens (falls back to JWT_SECRET)
CORS_ALLOWED_ORIGINS=               # extra origins allowed to call the CRM API besides APP_URL (comma-separated)

# Master API key for server-to-server APIs (Firebase function `api`, Cloudflare wrangler.api.toml).
# Generate with `npm run key:generate`, which writes it here in .env. Never expose it to the browser.
MASTER_API_KEY=

# --- Meeting plans (Free / Premium / Enterprise) ---
# Platform administrators: user ids (comma-separated) who can edit plan limits and features, change
# organizations' subscriptions, approve upgrade requests and monitor meetings (Settings → Plan Administration).
# Plan limits themselves are stored in the database (platform_config/meeting_plans), not here.
PLATFORM_ADMIN_USER_IDS=

# Meeting audio/video (LiveKit Cloud or self-hosted). Without these, meetings run (roster, limits, chat on
# screen) but say plainly that video between people isn't connected.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Security hardening (docs/compliance/SECURITY_CONTROLS.md) ----
# Proxy hops to trust for the client IP (rate limits, sign-in monitoring). e.g. 1 on Cloud Run/Render/Heroku.
TRUST_PROXY=
# Enforce the Content-Security-Policy (otherwise it's sent as Report-Only in production).
CSP_ENFORCE=false
# Other sites allowed to frame the app (CSP frame-ancestors); default is this site only.
FRAME_ANCESTORS=
# Sign-in failure monitoring: failures per IP within the window before 429 for the lockout period.
AUTH_FAILURE_LIMIT=20
AUTH_FAILURE_WINDOW_MINUTES=15
AUTH_LOCKOUT_MINUTES=15
# Salt for hashed IP addresses in the audit log (keep stable across restarts). Generate a random value.
AUDIT_IP_SALT=
