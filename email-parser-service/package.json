{
  "name": "email-parser-service",
  "version": "1.0.0",
  "description": "Cloudflare Worker service for inbound email parsing and RFC 822 / MIME decoding using postal-mime with Node.js compatibility",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "tsc --noEmit",
    "test": "node test.js"
  },
  "keywords": [
    "cloudflare-workers",
    "email-parser",
    "postal-mime",
    "email-routing",
    "nodejs-compat"
  ],
  "dependencies": {
    "postal-mime": "^2.7.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "typescript": "^5.8.2",
    "wrangler": "^3.114.0"
  }
}
