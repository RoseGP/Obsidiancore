        },
        "client": {
          "type": "string",
          "description": "Client company or account name"
        },
        "value": {
          "type": "number",
          "description": "Monetary value of the deal in USD"
        },
        "stage": {
          "type": "string",
          "enum": [
            "discovery",
            "qualified",
            "proposal",
            "negotiation",
            "closing",
            "won",
            "lost"
