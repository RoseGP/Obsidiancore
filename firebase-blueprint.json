{
  "entities": {
    "User": {
      "title": "User",
      "description": "Primary user profile document containing high-level identity data.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The unique user ID matching Firebase Authentication UID."
        },
        "email": {
          "type": "string",
          "description": "Primary email address of the user."
        },
        "displayName": {
          "type": "string",
          "description": "Display name or name of the user."
        },
        "photoURL": {
          "type": "string",
          "description": "URL to the user's avatar image."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Firebase server timestamp representing creation time."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Firebase server timestamp representing last update time."
        }
      },
      "required": [
        "uid",
        "email",
        "createdAt",
        "updatedAt"
      ]
    },
    "Channel": {
      "title": "Channel",
      "description": "Sub-collection document holding OAuth access tokens and metadata for linked social networks.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the channel (e.g. linkedin, instagram)."
        },
        "platform": {
          "type": "string",
          "enum": [
            "facebook",
            "instagram",
            "linkedin",
            "tiktok",
            "x",
            "youtube"
          ],
          "description": "The target social network platform."
        },
        "connected": {
          "type": "boolean",
          "description": "Indicates whether the connection is active."
        },
        "handle": {
          "type": "string",
          "description": "The public handle or username of the account (e.g., @flow_forge)."
        },
        "accessToken": {
          "type": "string",
          "description": "OAuth 2.0 Access Token used to authenticate publisher requests."
        },
        "refreshToken": {
          "type": "string",
          "description": "OAuth 2.0 Refresh Token used to request new Access Tokens."
        },
        "tokenExpiry": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp indicating when the accessToken expires."
        },
        "profilePictureUrl": {
          "type": "string",
          "description": "Account avatar or branding photo from the provider API."
        },
        "scope": {
          "type": "array",
          "description": "List of authorized OAuth scopes granted by the user."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Firebase server timestamp representing last sync time."
        }
      },
      "required": [
        "id",
        "platform",
        "connected",
        "accessToken",
        "updatedAt"
      ]
    },
    "Post": {
      "title": "Post",
      "description": "Root-level or relational document containing scheduled social media posts.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique auto-generated document ID."
        },
        "userId": {
          "type": "string",
          "description": "The UID of the user who owns/created the post."
        },
        "content": {
          "type": "string",
          "description": "Main text content or caption of the social post."
        },
        "caption": {
          "type": "string",
          "description": "Main text content or caption of the social post."
        },
        "mediaUrls": {
          "type": "array",
          "description": "Array of strings or objects containing multi-photo or video assets."
        },
        "scheduled_at": {
          "type": "string",
          "format": "date-time",
          "description": "Firebase timestamp specifying when the post should publish."
        },
        "scheduledAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp specifying when the post should publish."
        },
        "platforms": {
          "type": "array",
          "description": "Array of target channel/platform IDs (e.g., ['x', 'linkedin', 'bluesky', 'mastodon'])."
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "published",
            "failed",
            "processing",
            "draft",
            "scheduled",
            "partial_success"
          ],
          "description": "Current publication lifecycle status."
        },
        "failure_reason": {
          "type": "string",
          "description": "Publish failure logs or error messages from API response."
        },
        "error": {
          "type": "string",
          "description": "Publish failure logs or error messages from API response."
        },
        "actual_publish_time": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp indicating when the post was published."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last modified timestamp."
        }
      },
      "required": [
        "userId",
        "caption",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "SocialAccount": {
      "title": "SocialAccount",
      "description": "Schema storing connected external social media accounts with encrypted tokens.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the account document."
        },
        "userId": {
          "type": "string",
          "description": "The UID of the user who owns this connected social account."
        },
        "platform": {
          "type": "string",
          "enum": [
            "x",
            "twitter",
            "linkedin",
            "bluesky",
            "mastodon",
            "facebook",
            "instagram"
          ],
          "description": "Target social media platform."
        },
        "handle": {
          "type": "string",
          "description": "Account handle or username (e.g. @sarah_jenkins)."
        },
        "encryptedToken": {
          "type": "string",
          "description": "AES-256-GCM encrypted access token or secret."
        },
        "iv": {
          "type": "string",
          "description": "AES-256-GCM initialization vector in hexadecimal."
        },
        "authTag": {
          "type": "string",
          "description": "AES-256-GCM authentication tag in hexadecimal."
        },
        "refreshToken": {
          "type": "string",
          "description": "Optional encrypted OAuth refresh token."
        },
        "instanceUrl": {
          "type": "string",
          "description": "Optional server instance domain (e.g. for Mastodon)."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last synchronization timestamp."
        }
      },
      "required": [
        "id",
        "userId",
        "platform",
        "handle",
        "encryptedToken",
        "iv",
        "authTag",
        "updatedAt"
      ]
    },
    "Draft": {
      "title": "Draft",
      "description": "User social post drafts that are saved to continue editing later.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique auto-generated document ID."
        },
        "userId": {
          "type": "string",
          "description": "The UID of the user who owns/created the draft."
        },
        "caption": {
          "type": "string",
          "description": "Main text content or caption of the social post draft."
        },
        "mediaUrl": {
          "type": "string",
          "description": "URL of the optional image attachment."
        },
        "mediaName": {
          "type": "string",
          "description": "Filename of the optional image attachment."
        },
        "platforms": {
          "type": "array",
          "description": "Array of target platforms selected for the draft."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Draft creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Draft last modified timestamp."
        }
      },
      "required": [
        "userId",
        "caption",
        "createdAt",
        "updatedAt"
      ]
    },
    "LinkedInScheduledPost": {
      "title": "LinkedInScheduledPost",
      "description": "Enterprise-grade database schema representing a scheduled or dispatched LinkedIn social post.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique auto-generated Firestore document ID."
        },
        "user_id": {
          "type": "string",
          "description": "The Firebase Authentication UID of the user who owns or scheduled this post."
        },
        "linkedin_member_urn": {
          "type": "string",
          "description": "The unique URN for the target LinkedIn member account (e.g., urn:li:person:abcdefgh)."
        },
        "encrypted_access_token": {
          "type": "string",
          "description": "AES-256-GCM encrypted LinkedIn OAuth access token. Never stored in plain text."
        },
        "post_content": {
          "type": "string",
          "description": "The body, text commentary, or markdown content of the LinkedIn post."
        },
        "scheduled_publish_time": {
          "type": "string",
          "format": "date-time",
          "description": "Firebase server timestamp or UTC timestamp specifying when the post should be published."
        },
        "actual_publish_time": {
          "type": "string",
          "format": "date-time",
          "description": "Firebase server timestamp indicating when the post was successfully shared on LinkedIn."
        },
        "linkedin_post_urn": {
          "type": "string",
          "description": "The unique post or Share URN returned by the LinkedIn UGC/Share API after creation (e.g., urn:li:share:123456789)."
        },
        "retry_count": {
          "type": "integer",
          "description": "Number of failed delivery attempts. Useful for exponential backoff algorithms."
        },
        "failure_reason": {
          "type": "string",
          "description": "The detail/text block describing the API or network failure reason if the post state is FAILED."
        },
        "status": {
          "type": "string",
          "enum": [
            "DRAFT",
            "SCHEDULED",
            "PROCESSING",
            "PUBLISHED",
            "FAILED"
          ],
          "description": "Current lifecycle status of the LinkedIn post publication."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Document creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Document last updated timestamp."
        }
      },
      "required": [
        "user_id",
        "linkedin_member_urn",
        "encrypted_access_token",
        "post_content",
        "scheduled_publish_time",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "LinkedInAccount": {
      "title": "LinkedInAccount",
      "description": "Schema to manage LinkedIn OAuth tokens and basic profile info.",
      "type": "object",
      "properties": {
        "user_id": {
          "type": "string",
          "description": "The UID of the user who owns this connected LinkedIn account."
        },
        "provider_account_id": {
          "type": "string",
          "description": "The unique URN for the LinkedIn member (e.g., urn:li:person:abcdefgh)."
        },
        "access_token": {
          "type": "string",
          "description": "Plaintext or encrypted LinkedIn OAuth access token."
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp indicating when the access token expires."
        },
        "refresh_token": {
          "type": "string",
          "description": "The LinkedIn OAuth refresh token used to rotatively renew access tokens."
        },
        "refresh_token_expires_at": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp indicating when the refresh token expires."
        },
        "name": {
          "type": "string",
          "description": "Basic profile display name of the LinkedIn user."
        },
        "avatar_url": {
          "type": "string",
          "description": "Basic profile avatar URL of the LinkedIn user."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Document creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Document last updated timestamp."
        }
      },
      "required": [
        "user_id",
        "provider_account_id",
        "access_token",
        "expires_at",
        "createdAt",
        "updatedAt"
      ]
    },
    "ScheduledPost": {
      "title": "ScheduledPost",
      "description": "Schema to manage scheduled posts for LinkedIn.",
      "type": "object",
      "properties": {
        "user_id": {
          "type": "string",
          "description": "The UID of the user who scheduled the post."
        },
        "provider_account_id": {
          "type": "string",
          "description": "The unique URN of the LinkedIn account used for publishing (e.g. urn:li:person:abc)."
        },
        "commentary": {
          "type": "string",
          "description": "Text commentary/content of the LinkedIn post."
        },
        "media_urls": {
          "type": "array",
          "description": "Array of media URLs uploaded and attached to the post."
        },
        "scheduled_at": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp indicating when the post is scheduled to publish."
        },
        "status": {
          "type": "string",
          "enum": [
            "PENDING",
            "PUBLISHED",
            "FAILED"
          ],
          "description": "Lifecycle status of the scheduled post."
        },
        "failure_reason": {
          "type": "string",
          "description": "Text content detailing the cause of a delivery failure."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Document creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Document last updated timestamp."
        }
      },
      "required": [
        "user_id",
        "provider_account_id",
        "commentary",
        "scheduled_at",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "CRMDeal": {
      "title": "CRMDeal",
