        "momentum": {
          "type": "string",
          "enum": [
            "hot",
            "steady",
            "stagnant"
          ],
          "description": "Deal velocity indicator"
        },
        "channelOrigin": {
          "type": "string",
          "description": "Originating channel e.g. whatsapp, web, phone, email"
        },
        "owner": {
          "type": "string",
          "description": "Responsible sales executive or closer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "client",
        "value",
        "stage",
        "createdAt",
        "updatedAt"
      ]
    },
